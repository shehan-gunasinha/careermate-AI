# Copy to .env and adjust. Never commit the real .env file.

# --- Database (PostgreSQL) ---
POSTGRES_DB=careermate
POSTGRES_USER=careermate
POSTGRES_PASSWORD=change-me

# --- Security ---
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MINUTES=1440
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Encrypts user-added Gemini keys at rest. Generate separately from JWT_SECRET.
# If empty, the backend falls back to JWT_SECRET.
API_KEY_ENCRYPTION_SECRET=replace-with-a-different-long-random-secret

# --- Google Gemini (optional; the app works without it using fallback logic) ---
# Optional shared server key. Users can also add their own key from Settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Email / SMTP (used for "forgot password" one-time codes) ---
# Example for Gmail: host smtp.gmail.com, port 587, username = your address, password = an App Password.
# Leave MAIL_HOST empty in local development: the reset code is printed in the backend log instead.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@careermate.local
MAIL_FROM_NAME=CareerMate AI
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5

# --- Demo data (disable in production) ---
SEED_DEMO_DATA=true
ADMIN_EMAIL=admin@careermate.local
ADMIN_PASSWORD=Admin@12345
DEMO_USER_EMAIL=demo@careermate.local
DEMO_USER_PASSWORD=Demo@12345

# --- External job synchronisation (real listings used for matching) ---
# ITPro.lk, Remotive and Arbeitnow are keyless. Jooble and JSearch need a key and stay off until one is provided.
JOB_SYNC_ENABLED=true
JOB_SYNC_CRON=0 0 */6 * * *
JOB_SYNC_ON_STARTUP=true
JOB_PREFER_EXTERNAL=true
JOB_SYNC_ITPRO=true
JOB_SYNC_REMOTIVE=true
JOB_SYNC_ARBEITNOW=true
JOB_SYNC_MAX_PER_SOURCE=50
JOB_SYNC_STALE_DAYS=21

# ITPro.lk (Sri Lanka): type/category 0 = all; see https://itpro.lk/developer/
ITPRO_COUNT=50
ITPRO_DAYS_BEHIND=30
ITPRO_TYPE=0
ITPRO_CATEGORY=0

# Jooble: free key from https://jooble.org/api/about
JOOBLE_ENABLED=false
JOOBLE_API_KEY=
JOOBLE_KEYWORDS=software engineer
JOOBLE_LOCATION=Sri Lanka
JOOBLE_MAX_PAGES=5

# JSearch (RapidAPI): key from https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_ENABLED=false
JSEARCH_API_KEY=
JSEARCH_HOST=jsearch.p.rapidapi.com
JSEARCH_QUERY=software engineer
JSEARCH_COUNTRY=lk
JSEARCH_NUM_PAGES=1

# --- Ports ---
FRONTEND_PORT=3000
BACKEND_PORT=8080
